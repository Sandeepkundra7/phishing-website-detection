# PhishShield AI Environment Configuration Template

# Database Configuration (Local SQLite by default)
DATABASE_URL=sqlite:///./phishing_db.sqlite
SQLITE_FALLBACK_URL=sqlite:///./phishing_db.sqlite

# Security & JWT Token Authentication
SECRET_KEY=replace-with-a-random-secret-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS Origins
PROJECT_NAME="AI Phishing Detection API"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
